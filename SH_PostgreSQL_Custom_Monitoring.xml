    <templates>
        <template>
            <uuid>110e8d738f474e638a0d8ecb65f9dbde</uuid>
            <template>SH PostgreSQL Custom Monitoring</template>
            <name>SH PostgreSQL Custom Monitoring</name>
            <description>Комплексный мониторинг PostgreSQL: cache hit ratio, ожидания, параметры конфигурации, WAL, VACUUM, репликация, размер БД</description>
            <groups>
                <group>
                    <name>Templates/Databases</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>5e6f7a8b9c0d4e1f8a3bc4d5e6f7a8b9</uuid>
                    <name>SH PostgreSQL: archive_mode</name>
                    <key>pg.show[archive_mode]</key>
                    <delay>6h</delay>
                    <value_type>TEXT</value_type>
                    <description>Режим архивации WAL (off, on, always)</description>
                </item>
                <item>
                    <uuid>e577512dd3214a7dae27510ff571e638</uuid>
                    <name>SH PostgreSQL: autovacuum_max_workers</name>
                    <key>pg.show[autovacuum_max_workers]</key>
                    <delay>6h</delay>
                    <value_type>FLOAT</value_type>
                    <description>Максимум воркеров autovacuum</description>
                </item>
                <item>
                    <uuid>5160b22e4e9042789607765c09627119</uuid>
                    <name>SH PostgreSQL: autovacuum_work_mem</name>
                    <key>pg.show[autovacuum_work_mem]</key>
                    <delay>6h</delay>
                    <value_type>FLOAT</value_type>
                    <units>MB</units>
                    <description>Память на воркер autovacuum (MB)</description>
                    <triggers>
                        <trigger>
                            <uuid>30c12c4e0c7e4fbd98fce6e69f0d33f2</uuid>
                            <expression>last(/SH PostgreSQL Custom Monitoring/pg.show[autovacuum_work_mem])&lt;{$PG.AUTOVACUUM_MEM.MIN}</expression>
                            <name>PostgreSQL: autovacuum_work_mem слишком мал ({ITEM.LASTVALUE})</name>
                            <priority>WARNING</priority>
                            <description>autovacuum_work_mem ниже {$PG.AUTOVACUUM_MEM.MIN} MB.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>1a2b3c4d5e6f4a7b8c9de0f1a2b3c4d5</uuid>
