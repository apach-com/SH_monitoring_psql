                    <triggers>
                        <trigger>
                            <uuid>d9cabfb211f94beb98d4091226171363</uuid>
                            <expression>last(/SH PostgreSQL Custom Monitoring/pg.show[shared_buffers])&lt;{$PG.SHARED_BUFFERS.MIN}</expression>
                            <name>PostgreSQL: shared_buffers слишком мал ({ITEM.LASTVALUE})</name>
                            <priority>WARNING</priority>
                            <description>shared_buffers ниже {$PG.SHARED_BUFFERS.MIN} MB.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>7a8b9c0d1e2f4a3bac5de6f7a8b9c0d1</uuid>
